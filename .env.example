# Backend only. Never put secrets in VITE_ variables.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_MODE=offline
JARVIS_OPENAI_MODEL=gpt-4.1-mini
JARVIS_OLLAMA_MODEL=qwen3:0.6b
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# Optional; required only for OpenAI features. Do not share this file after editing.
OPENAI_API_KEY=

# Native microphone and follow-up conversation
JARVIS_LANGUAGE=auto
JARVIS_WAKE_THRESHOLD=0.55
JARVIS_FOLLOWUP_SECONDS=15
JARVIS_SPEECH_VOLUME=0.8
# JARVIS_MICROPHONE_DEVICE=0
